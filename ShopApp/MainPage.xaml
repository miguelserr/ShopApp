<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopApp.Views.MainPage"
             Title="Inicio">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="15">

            <Label Text="Resumen de la tienda"
                   FontSize="24"
                   FontAttributes="Bold" />

            <Label Text="Total de categorías:"
                   FontSize="16" />

            <Label x:Name="Category"
                   FontSize="20" />

            <Label Text="Total de clientes:"
                   FontSize="16" />

            <Label x:Name="Client"
                   FontSize="20" />

            <Label Text="Total de productos:"
                   FontSize="16" />

            <Label x:Name="Product"
                   FontSize="20" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>