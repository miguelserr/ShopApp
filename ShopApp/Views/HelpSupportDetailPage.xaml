<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ShopApp.Views.HelpSupportDetailPage"
    Title="HelpSupportDetailPage">

    <FlexLayout
        Direction="Column"
        JustifyContent="Center"
        AlignItems="Center"
        Padding="10">

        <Grid
            ColumnDefinitions="*,*"
            HeightRequest="330"
            WidthRequest="700">

            <VerticalStackLayout>

                <CollectionView
                    ItemsSource="{Binding Products}"
                    SelectedItem="{Binding ProductoSeleccionado, Mode=TwoWay}"
                    ItemTemplate="{StaticResource ProductDataTemplate}"
                    HeightRequest="300"
                    SelectionMode="Single"/>

                <HorizontalStackLayout VerticalOptions="Center">

                    <Stepper
                        Minimum="1"
                        Maximum="100"
                        Increment="1"
                        x:Name="cantidad"
                        Value="{Binding Cantidad, Mode=TwoWay}"/>

                    <Label
                        VerticalOptions="Center"
                        Margin="4"
                        Text="{Binding Value, Source={x:Reference cantidad}}"/>

                </HorizontalStackLayout>

            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1">

                <Label Text="Nombre"/>
                <Label Text="{Binding ProductoSeleccionado.Nombre}"/>
                <Label Text="Descripcion"/>
                <Label Text="{Binding ProductoSeleccionado.Descripcion}"/>
                <Label Text="Precio"/>
                <Label Text="{Binding ProductoSeleccionado.Precio}"/>

            </VerticalStackLayout>

        </Grid>

        <Button
            Text="Agregar"
            Command="{Binding AddCommand}"
            WidthRequest="300"/>

        <CollectionView
            ItemsSource="{Binding Compras}"
            HeightRequest="220"
            WidthRequest="700"
            FlexLayout.Grow="1"/>

        <Button
            Text="Finalizar Compra"
            Command="{Binding EnviarCompraCommand}"
            WidthRequest="300"/>
    </FlexLayout>
</ContentPage>
